<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/xsmall_margin"
        android:foregroundGravity="center"
        android:orientation="vertical"
        app:cardBackgroundColor="@color/gradient_top"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp"
        app:cardUseCompatPadding="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/studentImage"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:src="@drawable/ic_person"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/studentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ivan Draganov"
                android:textStyle="bold"
                app:layout_constraintLeft_toRightOf="@id/studentImage"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/studentEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ivan.draganov@gmail.com"
                android:textStyle="italic"
                app:layout_constraintLeft_toRightOf="@id/studentImage"
                app:layout_constraintTop_toBottomOf="@id/studentName" />

            <TextView
                android:id="@+id/studentGrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bachelor"
                app:layout_constraintLeft_toRightOf="@id/studentImage"
                app:layout_constraintTop_toBottomOf="@id/studentEmail" />

            <TextView
                android:id="@+id/studentCourses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="III"
                android:gravity="center"
                android:textSize="@dimen/text_size_middle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@id/studentEmail"
                app:layout_constraintRight_toLeftOf="@id/editIcon"/>

            <TextView
                android:id="@+id/studentSpeciality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Computer Speciality"
                app:layout_constraintLeft_toRightOf="@id/studentImage"
                app:layout_constraintTop_toBottomOf="@id/studentGrade" />

            <!-- Edit Buttons -->
            <androidx.constraintlayout.utils.widget.ImageFilterButton
                android:id="@+id/editIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:src="@drawable/ic_edit"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Delete Button -->
            <androidx.constraintlayout.utils.widget.ImageFilterButton
                android:id="@+id/deleteIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:src="@drawable/ic_delete"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/editIcon" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>